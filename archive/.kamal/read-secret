#!/bin/sh
# Usage: .kamal/read-secret NAME
# Prints one value from the deploy secrets file (the "export NAME=value" file
# that used to be sourced by hand on bigballs). Exits non-zero if it is empty.
set -e
f="$HOME/.config/archive/production.env"
. "$f"
eval "val=\"\${$1}\""
[ -n "$val" ] || { echo "read-secret: $1 is empty in $f" >&2; exit 1; }
printf %s "$val"
