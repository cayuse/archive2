#!/bin/sh
# Usage: .kamal/read-secret NAME [FILE]
# Prints one value from a deploy secrets file ("export NAME=value" lines) under ~/.config/archive/:
# production.env by default, or FILE (e.g. peers/gameforge.env). Exits non-zero if it is empty.
set -e
f="$HOME/.config/archive/${2:-production.env}"
. "$f"
eval "val=\"\${$1}\""
[ -n "$val" ] || { echo "read-secret: $1 is empty in $f" >&2; exit 1; }
printf %s "$val"
