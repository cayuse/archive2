# Secrets shared by every peer. Each peer adds its own in .kamal/peer-secrets.<peer>, read from
# ~/.config/archive/peers/<peer>.env on the deploying machine (chmod 600; never in git).
# The master key decrypts config/credentials.yml.enc, which is built into the image (same for all).
RAILS_MASTER_KEY=$(.kamal/read-secret RAILS_MASTER_KEY)
AWS_SES_SMTP_USERNAME=$(.kamal/read-secret AWS_SES_SMTP_USERNAME)
AWS_SES_SMTP_PASSWORD=$(.kamal/read-secret AWS_SES_SMTP_PASSWORD)
KAMAL_REGISTRY_PASSWORD=$(sed -n 's/^KAMAL_REGISTRY_PASSWORD=//p' /home/sauce/secrets/jeedata/ghcr.env)
