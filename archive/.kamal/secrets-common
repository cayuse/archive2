# Secrets are NOT stored in git. .kamal/read-secret reads them from
# ~/.config/archive/production.env on the machine running kamal (the same
# "export NAME=value" file that used to be sourced by hand on bigballs).
# Keep that file chmod 600. Don't use $VARS on this page: Kamal's dotenv
# expands them before running the $(...) commands, so they come out empty.
RAILS_MASTER_KEY=$(.kamal/read-secret RAILS_MASTER_KEY)
POSTGRES_PASSWORD=$(.kamal/read-secret POSTGRES_PASSWORD)
DATABASE_URL=$(.kamal/read-secret POSTGRES_PASSWORD | sed 's|.*|postgres://postgres:&@archive-db-1:5432/archive_production|')
AWS_SES_SMTP_USERNAME=$(.kamal/read-secret AWS_SES_SMTP_USERNAME)
AWS_SES_SMTP_PASSWORD=$(.kamal/read-secret AWS_SES_SMTP_PASSWORD)
MUSICBRAINZ_URL=$(.kamal/read-secret MUSICBRAINZ_URL)

# Same GHCR token the other apps use (read from the same file jeesauce.com/.kamal/secrets-common uses).
KAMAL_REGISTRY_PASSWORD=$(sed -n 's/^KAMAL_REGISTRY_PASSWORD=//p' /home/sauce/secrets/jeedata/ghcr.env)
