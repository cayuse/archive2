# Peer "gameforge": its own database password and secret_key_base, from
# ~/.config/archive/peers/gameforge.env. DATABASE_URL points at the peer's own db accessory.
POSTGRES_PASSWORD=$(.kamal/read-secret POSTGRES_PASSWORD peers/gameforge.env)
SECRET_KEY_BASE=$(.kamal/read-secret SECRET_KEY_BASE peers/gameforge.env)
DATABASE_URL=$(.kamal/read-secret POSTGRES_PASSWORD peers/gameforge.env | sed 's|.*|postgres://postgres:&@archive-db:5432/archive_production|')
MUSICBRAINZ_URL=$(.kamal/read-secret MUSICBRAINZ_URL peers/gameforge.env)
