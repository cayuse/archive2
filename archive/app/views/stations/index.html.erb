<%= render "stations/styles" %>
<div class="container stations-page">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0 theme-text-primary">Stations</h1>
    <span class="theme-text-secondary small">A station plays songs that sound like its seeds and learns from your thumbs.</span>
  </div>

  <% if alert %><div class="alert alert-warning"><%= alert %></div><% end %>
  <div id="stations-error" class="alert alert-danger d-none"></div>

  <div class="card mb-4">
    <div class="card-header"><h5 class="mb-0 theme-text-primary">Start a new station from a song</h5></div>
    <div class="card-body">
      <div class="input-group">
        <input type="search" id="new-station-q" class="form-control" placeholder="Search title, artist, album…" autocomplete="off">
        <button class="btn btn-primary" id="new-station-go" type="button">Search</button>
      </div>
      <ul class="list-group list-group-flush mt-2" id="new-station-results"></ul>
    </div>
  </div>

  <% if @playlists.any? %>
    <div class="card mb-4">
      <div class="card-header"><h5 class="mb-0 theme-text-primary">Start a new station from a playlist</h5></div>
      <div class="card-body">
        <div class="row g-2 align-items-center">
          <div class="col-md-5">
            <select id="new-station-playlist" class="form-select">
              <% @playlists.each do |playlist| %><option value="<%= playlist.id %>"><%= playlist.name %></option><% end %>
            </select>
          </div>
          <div class="col-md-5">
            <select id="new-station-playlist-mode" class="form-select">
              <option value="inspire">This playlist, plus songs that sound like it</option>
              <option value="only">Only songs from this playlist</option>
            </select>
          </div>
          <div class="col-md-2 d-grid"><button class="btn btn-primary" id="new-station-playlist-go" type="button">Start station</button></div>
        </div>
        <p class="small theme-text-secondary mb-0 mt-2">The playlist stays linked: change it later and the station follows.</p>
      </div>
    </div>
  <% end %>

  <div class="row" id="stations-list">
    <% @stations.each do |station| %>
      <div class="col-md-6 col-lg-4 mb-3">
        <div class="card h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title theme-text-primary mb-1">
              <%= station.name %>
              <% if station.live? %><span class="badge bg-success ms-1">● Live</span><% end %>
              <% if station.station&.shared? %><span class="badge bg-info ms-1">Shared</span><% end %>
            </h5>
            <% if (source = station.station&.parent) %>
              <p class="theme-text-secondary small mb-1">Copied from <%= source.user&.name || "someone" %>'s <%= source.name %></p>
            <% end %>
            <% seeds = Song.includes(:artist).where(id: station.radio_seed_ids).index_by(&:id).values_at(*station.radio_seed_ids).compact %>
            <p class="theme-text-secondary small flex-grow-1 mb-2">
              <% linked = station.station ? station.station.station_playlists.includes(:playlist).to_a : [] %>
              <% if linked.any? %>
                <%= linked.map { |l| l.mode == "only" ? "Only plays #{l.playlist&.name}" : "Plays #{l.playlist&.name} and songs that sound like it" }.to_sentence %>.
              <% end %>
              <% if seeds.any? %>
                Built around <%= seeds.first(3).map { |s| [ s.title, s.artist&.name ].compact.join(" by ") }.to_sentence %><%= " and #{seeds.size - 3} more" if seeds.size > 3 %>.
              <% elsif linked.empty? %>
                No seed yet. Start it from a song, or request one while it plays.
              <% end %>
            </p>
            <div class="d-flex flex-wrap gap-2">
              <%= link_to "Tune", station_path(station), class: "btn btn-primary btn-sm" %>
              <%= link_to "Play in browser", player_jukebox_path(station), class: "btn btn-outline-success btn-sm", target: "_blank", rel: "noopener" %>
              <% if local_playback_available? %>
                <% if station.server_playback? %>
                  <%= link_to "On the speakers: remote", player_jukebox_path(station), class: "btn btn-success btn-sm", target: "_blank", rel: "noopener" %>
                <% else %>
                  <%= button_to "Play on #{current_archive.name}'s speakers", server_playback_jukebox_path(station), method: :patch, params: { server_playback: 1, play: 1 }, class: "btn btn-outline-success btn-sm", form: { target: "_blank" } %>
                <% end %>
              <% end %>
              <% unless station.station&.permanent? %>
                <button type="button" class="btn btn-outline-danger btn-sm ms-auto" data-delete-station="<%= station.id %>" data-name="<%= station.name %>">Delete</button>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <h2 class="h4 theme-text-primary mt-4" id="shared">Shared stations</h2>
  <p class="theme-text-secondary small">Stations people here have shared (switch "Share" on a station's tuning page to list yours).
    Nothing lands in your stations until you add one: you then get your own copy with everything it has learned so far,
    and from there yours and theirs go their own ways.</p>
  <div class="card mb-4">
    <div class="table-responsive">
      <table class="table mb-0 align-middle">
        <thead><tr><th>Station</th><th>Shared by</th><th>Originally by</th><th>Built on</th><th class="text-nowrap">Taught</th><th>Copies</th><th></th></tr></thead>
        <tbody id="shared-list"><tr><td colspan="7" class="theme-text-secondary small">Loading…</td></tr></tbody>
      </table>
    </div>
  </div>
</div>

<script>window.STATIONS_CONFIG = { apiToken: <%= raw @api_token.to_json %> };</script>
<script src="/javascripts/stations/stations.js?v=20261127b"></script>
<script>StationsPage.initIndex();</script>
