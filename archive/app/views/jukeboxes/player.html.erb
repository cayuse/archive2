<% content_for :hide_main_nav, true %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AJB Player - <%= @jukebox.name %></title>
  <%= render 'player_scripts' %>
  
  <link rel="stylesheet" href="/stylesheets/ajb.css?v=20261126c">
</head>
<body class="ajb-page">
  <div id="ajb-player-root" class="ajb">
    <div id="react-player-app">
      <div class="ajb-loading">
        <div class="spinner-border" role="status"></div>
        <p>Loading player…</p>
      </div>
    </div>
  </div>

  <script>
    // Initialize ActionCable (if available)
    window.App = window.App || {};
    if (typeof ActionCable !== 'undefined') {
      window.App.cable = ActionCable.createConsumer('<%= Rails.application.config.action_cable.url || "/cable" %>');
    }
    
    <%
      # Generate API token directly in the template since controller method isn't working
      api_token = nil
      if current_user
        begin
          payload = {
            user_id: current_user.id,
            email: current_user.email,
            role: current_user.role,
            exp: 2.days.from_now.to_i,
            iat: Time.current.to_i,
            iss: 'archive-api'
          }
          
          json_payload = payload.to_json
          encryptor = ActiveSupport::MessageEncryptor.new(Rails.application.secret_key_base[0, 32])
          encrypted_token = encryptor.encrypt_and_sign(json_payload)
          api_token = Base64.urlsafe_encode64(encrypted_token)
        rescue => e
          Rails.logger.error "Token generation error in template: #{e.message}"
          api_token = nil
        end
      end
    %>
    
    // Configuration for the React app
    window.AJB_CONFIG = {
      sessionId: '<%= @jukebox.session_id %>',
      apiToken: '<%= api_token || 'NO_TOKEN_GENERATED' %>',
      jukeboxId: '<%= @jukebox.id %>',
      jukeboxName: '<%= j @jukebox.name %>',
      status: '<%= @jukebox.status %>',
      crossfadeEnabled: <%= @jukebox.crossfade_enabled %>,
      crossfadeDuration: <%= @jukebox.crossfade_duration %>,
      autoPlay: <%= @jukebox.auto_play %>,
      hasPassword: <%= @jukebox.has_password? %>,
      guestPassword: '<%= j(@jukebox.guest_password.to_s) %>',
      radio: <%= @jukebox.radio? %>,
      tuneUrl: <%= raw((@jukebox.station? ? station_path(@jukebox) : nil).to_json) %>
    };
  </script>
  
  <!-- Load all AJB modules.
       These are plain static files (not asset-pipelined), so bump ajb_v whenever
       any of them changes to force browsers/iOS to fetch the new code. -->
  <% ajb_v = "20261126-player-ui" %>
  <script src="/javascripts/ajb/models/AudioEngine.js?v=<%= ajb_v %>"></script>
  <script src="/javascripts/ajb/models/PlaybackState.js?v=<%= ajb_v %>"></script>
  <script src="/javascripts/ajb/services/ApiService.js?v=<%= ajb_v %>"></script>
  <script src="/javascripts/ajb/controllers/PlayerController.js?v=<%= ajb_v %>"></script>
  <script src="/javascripts/ajb/views/PlayerView.js?v=<%= ajb_v %>"></script>

  <!-- Load main app -->
  <script src="/javascripts/ajb/player.js?v=<%= ajb_v %>"></script>
</body>
</html>
