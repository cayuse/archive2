<% content_for :hide_main_nav, true %>

<%# Only boot the React SPA when the jukebox is actually live. When it's closed,
    render a plain server-side page (see _closed) — no JS, no escaping pitfalls. %>
<% if @jukebox.live? %>
<div id="ajb-guest-root" class="ajb">
  <div id="react-guest-app">
    <div class="ajb-loading">
      <div class="spinner-border" role="status"></div>
      <p>Loading…</p>
    </div>
  </div>
</div>

<script>
  // Configuration for the guest React app
  window.AJB_GUEST_CONFIG = {
    jukeboxId: '<%= @jukebox.id %>',
    jukeboxName: '<%= j @jukebox.name %>',
    sessionId: '<%= @jukebox.session_id %>',
    status: '<%= @jukebox.status %>',
    hasPassword: <%= @jukebox.has_password? %>,
    password: null // Will be set by user input
  };
  
  console.log('AJB Guest Config:', window.AJB_GUEST_CONFIG);
</script>

<!-- React and ReactDOM (self-hosted so the guest page works offline / on a LAN).
     Bootstrap CSS/JS and Font Awesome come from the application layout, also
     self-hosted. -->
<script src="/vendor/ajb/react.production.min.js"></script>
<script src="/vendor/ajb/react-dom.production.min.js"></script>

<!-- ActionCable for live now-playing / queue updates (self-hosted) -->
<script src="/vendor/ajb/actioncable.min.js"></script>
<script>
  window.App = window.App || {};
  if (typeof ActionCable !== 'undefined') {
    window.App.cable = ActionCable.createConsumer('/cable');
  }
</script>

<!-- Load all guest modules (bump ajb_v on any change to bust device caches) -->
<% ajb_v = "20261126-resume" %>
<script src="/javascripts/ajb/guest/models/GuestApiService.js?v=<%= ajb_v %>"></script>
<script src="/javascripts/ajb/guest/models/GuestState.js?v=<%= ajb_v %>"></script>
<script src="/javascripts/ajb/guest/controllers/GuestController.js?v=<%= ajb_v %>"></script>
<script src="/javascripts/ajb/guest/views/GuestView.js?v=<%= ajb_v %>"></script>

<!-- Load main guest app -->
<script src="/javascripts/ajb/guest/guest.js?v=<%= ajb_v %>"></script>
<% else %>
  <%= render 'closed' %>
<% end %>

<link rel="stylesheet" href="/stylesheets/ajb.css?v=20261126d">
