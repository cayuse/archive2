<%# A stream of songs that sound like @song, with links that steer it. %>
<%
  steer_links = [
    [ "More energy",   { energy: 0.6 } ],
    [ "Mellower",      { energy: -0.6 } ],
    [ "Happier",       { happiness: 0.6 } ],
    [ "Darker",        { happiness: -0.6 } ],
    [ "More acoustic", { acousticness: 0.6 } ],
    [ "More electronic", { electronic: 0.6 } ],
    [ "Danceable",     { danceability: 0.6 } ],
    [ "Instrumental",  { instrumental: 0.8 } ]
  ]
  feature = @song.audio_feature
  genre_links = [ [ "Any genre", "any" ], [ "#{@song.genre&.name} and similar", "adjacent" ], [ "Only #{@song.genre&.name}", "strict" ] ]
  genre_param = @genre_mode == "any" ? {} : { genre: @genre_mode }
%>
<div class="container">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Radio: <%= @song.title %> <small class="theme-text-muted">&middot; <%= @song.artist_display %></small></h1>
        <div class="btn-group" role="group">
          <% if feature && current_user&.can_host_jukebox? %>
            <%= button_to "Play this station", play_radio_song_path(@song, @steer.merge(genre_param)), method: :post,
                  class: "btn btn-success", title: "Play it live in the browser player", form: { class: "d-inline" } %>
          <% end %>
          <%= link_to "Reshuffle", radio_song_path(@song, @steer.merge(genre_param)), class: "btn btn-primary" %>
          <%= link_to "Back to Song", song_path(@song), class: "btn btn-outline-secondary" %>
        </div>
      </div>

      <% if feature.nil? %>
        <div class="alert alert-warning">This song has not been through audio analysis yet, so there is nothing to base a stream on.</div>
      <% else %>
        <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
          <span class="theme-text-muted">Steer:</span>
          <%= link_to "Just like this", radio_song_path(@song, genre_param), class: "btn btn-sm #{@steer.empty? ? 'btn-secondary' : 'btn-outline-secondary'}" %>
          <% steer_links.each do |label, dials| %>
            <% active = dials.stringify_keys.all? { |k, v| @steer[k].to_f == v } %>
            <%= link_to label, radio_song_path(@song, dials.merge(genre_param)), class: "btn btn-sm #{active ? 'btn-secondary' : 'btn-outline-secondary'}" %>
          <% end %>
        </div>

        <% if @song.genre %>
          <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
            <span class="theme-text-muted">Genre:</span>
            <% genre_links.each do |label, mode| %>
              <%= link_to label, radio_song_path(@song, @steer.merge(mode == "any" ? {} : { genre: mode })),
                    class: "btn btn-sm #{@genre_mode == mode ? 'btn-secondary' : 'btn-outline-secondary'}" %>
            <% end %>
          </div>
        <% end %>

        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><%= @songs.size %> songs that sound like this</h5>
            <% if current_user %>
              <div class="dropdown">
                <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" id="addToPlaylistDropdown" data-bs-toggle="dropdown" aria-expanded="false">Add selected to playlist</button>
                <ul class="dropdown-menu" aria-labelledby="addToPlaylistDropdown">
                  <% current_user.playlists.each do |playlist| %>
                    <li><a class="dropdown-item" href="#" onclick="radioAddToPlaylist('<%= playlist.id %>'); return false;"><%= playlist.name %></a></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
          <div class="card-body">
            <% if @songs.any? %>
              <div class="table-responsive">
                <table class="table table-hover song-list-table">
                  <thead>
                    <tr>
                      <th style="width: 40px;"><input type="checkbox" class="form-check-input" id="select-all-songs" checked></th>
                      <th>Title</th>
                      <th>Artist</th>
                      <th>Album</th>
                      <th>Genre</th>
                      <th>Duration</th>
                      <th>Play</th>
                      <th>Rate</th>
                    </tr>
                  </thead>
                  <tbody id="songs-table-body">
                    <%= render partial: 'songs/song_list', locals: { songs: @songs, show_checkbox: true } %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <p class="theme-text-muted">No similar songs found.</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  (function () {
    var boxes = function () { return document.querySelectorAll('#songs-table-body input[type="checkbox"]'); };
    boxes().forEach(function (b) { b.checked = true; });
    var all = document.getElementById('select-all-songs');
    if (all) all.addEventListener('change', function () { boxes().forEach(function (b) { b.checked = all.checked; }); });

    // Thumbs: one cell per row. A thumbs-down also greys the row out of this stream.
    var ratings = <%= raw @ratings.to_json %>;
    var paint = function (cell, value) {
      cell.querySelector('[data-rate="1"]').className = 'btn btn-sm ' + (value === 1 ? 'btn-success' : 'btn-outline-secondary');
      cell.querySelector('[data-rate="-1"]').className = 'btn btn-sm ' + (value === -1 ? 'btn-danger' : 'btn-outline-secondary');
    };
    document.querySelectorAll('#songs-table-body tr[data-song-id]').forEach(function (tr) {
      var id = tr.getAttribute('data-song-id');
      var cell = document.createElement('td');
      cell.style.whiteSpace = 'nowrap';
      cell.innerHTML = '<button type="button" data-rate="1" title="More like this">&#128077;</button> ' +
                       '<button type="button" data-rate="-1" title="Never play this for me">&#128078;</button>';
      tr.appendChild(cell);
      paint(cell, ratings[id] || 0);
      cell.querySelectorAll('button').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var want = parseInt(btn.getAttribute('data-rate'), 10);
          var value = (ratings[id] || 0) === want ? 0 : want;   // clicking the active thumb clears it
          fetch('/songs/' + id + '/rate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest',
                       'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
            body: JSON.stringify({ value: value })
          }).then(function (r) { return r.json(); }).then(function (d) {
            ratings[id] = d.value;
            paint(cell, d.value);
            var box = tr.querySelector('input[type="checkbox"]');
            if (d.value === -1) { tr.style.opacity = '0.35'; if (box) box.checked = false; } else { tr.style.opacity = ''; }
          });
        });
      });
    });

    window.radioAddToPlaylist = function (playlistId) {
      var ids = Array.prototype.map.call(document.querySelectorAll('#songs-table-body tr[data-song-id]'), function (tr) {
        var box = tr.querySelector('input[type="checkbox"]');
        return (!box || box.checked) ? tr.getAttribute('data-song-id') : null;
      }).filter(Boolean);
      if (!ids.length) return;
      fetch('/playlists/' + playlistId + '/add_songs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest',
                   'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
        body: JSON.stringify({ song_ids: ids })
      }).then(function (r) { return r.json(); }).then(function (d) {
        alert(d.message || d.error || 'Done');
      }).catch(function () { alert('Could not add songs to the playlist'); });
    };
  })();
</script>
