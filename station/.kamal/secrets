# Secrets are NOT stored in git. .kamal/read-secret reads them from
# ~/.config/archive/player.env on the machine running kamal. Don't use $VARS on this page:
# Kamal's dotenv expands them before running the $(...) commands, so they come out empty.
NODE_TOKEN=$(.kamal/read-secret NODE_TOKEN)
ARCHIVE_EMAIL=$(.kamal/read-secret ARCHIVE_EMAIL optional)
ARCHIVE_PASSWORD=$(.kamal/read-secret ARCHIVE_PASSWORD optional)

# Same GHCR token the archive deploy uses.
KAMAL_REGISTRY_PASSWORD=$(sed -n 's/^KAMAL_REGISTRY_PASSWORD=//p' /home/sauce/secrets/jeedata/ghcr.env)
