#!/bin/sh
# Usage: .kamal/read-secret NAME [optional]
# Prints one value from ~/.config/archive/player.env ("export NAME=value" lines, chmod 600).
# Exits non-zero if it is empty, unless "optional" is given.
set -e
f="$HOME/.config/archive/player.env"
. "$f"
eval "val=\"\${$1}\""
[ -n "$val" ] || [ "$2" = optional ] || { echo "read-secret: $1 is empty in $f" >&2; exit 1; }
printf %s "$val"
