# Archive as seen from this host (LAN address, not the public name, so audio never leaves the network)
ARCHIVE_URL=http://192.168.17.109:3000
# The node's player token: archive -> Settings -> Speakers. With it the daemon plays whichever jukebox
# is put on the speakers, whoever owns it.
NODE_TOKEN=
# Optional account for this control page's search and station list (DJ or above, with a local-playback
# grant). Without NODE_TOKEN the daemon polls as this account and plays only its own jukeboxes.
ARCHIVE_EMAIL=
ARCHIVE_PASSWORD=
OWNTONE_URL=http://127.0.0.1:3689
# Listen on the LAN address only. Never 0.0.0.0: this page has no login of its own.
BIND_HOST=192.168.17.109
BIND_PORT=8337
